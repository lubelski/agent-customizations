    "check": "npm run typecheck && npm test && npm run test:tui"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@earendil-works/pi-tui": "1.5.2",
    "@types/node": "26.6.4",
    "jiti": "2.7.0",
    "typebox": "1.3.27",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "acorn": "8.19.0",
    "acorn-walk": "8.3.5",
    "marked": "18.0.11"
  },
  "peerDependencies": {
    "typebox": "*"
  }
}
