{
  "name": "pi-customizations",
  "private": true,
  "license": "MIT",
  "type": "module",
  "pi": {
    "extensions": ["./extensions/ui.ts", "./extensions/session-rename.ts"],
    "themes": ["./themes/*.json"]
  },
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
